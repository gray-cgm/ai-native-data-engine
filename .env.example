APP_PROFILE=personal
API_HOST=0.0.0.0
API_PORT=8000
WEB_PORT=3000
BFF_HOST=0.0.0.0
BFF_PORT=3100
PLATFORM_API_BASE_URL=http://localhost:8000
DAGSTER_PORT=3001
# Docker Compose deploys Dagster OSS as webserver + daemon + user-code gRPC services.
JUPYTER_PORT=8888
JUPYTER_TOKEN=ad-engine
SUPERSET_PORT=8088
SUPERSET_SECRET_KEY=ai-data-loop-engine-secret
SUPERSET_ADMIN_USERNAME=admin
SUPERSET_ADMIN_PASSWORD=admin
SUPERSET_ADMIN_EMAIL=admin@example.com
# Superset runs inside Docker, so it must reach Postgres through the compose service name.
SUPERSET_DB_HOST=postgres
SUPERSET_DB_PORT=5432
SUPERSET_DB_NAME=ad_closure
SUPERSET_DB_USER=postgres
SUPERSET_DB_PASSWORD=postgres
POSTGRES_HOST=localhost
# Containers should use the compose service name instead of localhost.
POSTGRES_HOST_INTERNAL=postgres
# Superset in Docker Compose mounts the repo at /workspace and can inspect these paths:
# - /workspace/data/duckdb/app.duckdb
# - /workspace/data/silver/samples.parquet
# - /workspace/data/gold/dataset_samples.parquet
# In Docker Compose, internal services should reach Postgres via the service name `postgres`.
POSTGRES_PORT=5432
POSTGRES_DB=ad_closure
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATA_DIR=./data
EXAMPLES_DIR=./examples/datasets/custom-local

# ── Kafka (streaming) ────────────────────────────────────────────────────
# Host-side bootstrap (used by api/orchestrator running outside compose).
# In-compose services must use the compose hostname `kafka:9093` instead.
KAFKA_PORT=9092
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_BOOTSTRAP_SERVERS_INTERNAL=kafka:9093
KAFKA_CLUSTER_NAME=ad-loop-local
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk
# Streaming pipeline topics (auto-created on first publish if AUTO_CREATE_TOPICS_ENABLE=true)
KAFKA_TOPIC_EVENTS=streaming.events.raw
KAFKA_TOPIC_DLQ=streaming.events.dlq
KAFKA_CONSUMER_GROUP=ad-loop-streaming-consumer

# Kafka UI — observable console for streaming pipeline (parallel to Dagster console).
KAFKA_UI_PORT=8085
TOOL_KAFKA_UI_BASE_URL=http://127.0.0.1:8085

# Tool base URLs are exposed to the platform/BFF for gateway+health probing.
TOOL_DAGSTER_BASE_URL=http://127.0.0.1:3001
TOOL_SUPERSET_BASE_URL=http://127.0.0.1:8088
TOOL_JUPYTER_BASE_URL=http://127.0.0.1:8888
